@import "tailwindcss" source(none);
@source @HTML_SOURCE@;
@source @SCHEME_SOURCE@;
@source @CATALOG_SOURCE@;
@plugin @DAISYUI@ {
  themes: false;
  logs: false;
}
@plugin @DAISYUI_THEME@ {
  name: "modus-operandi";
  default: true;
  prefersdark: false;
  color-scheme: light;
  --color-base-100: #ffffff;
  --color-base-200: #f2f2f2;
  --color-base-300: #e0e0e0;
  --color-base-content: #000000;
  --color-primary: #0031a9;
  --color-primary-content: #ffffff;
  --color-secondary: #721045;
  --color-secondary-content: #ffffff;
  --color-accent: #005e8b;
  --color-accent-content: #ffffff;
  --color-neutral: #595959;
  --color-neutral-content: #ffffff;
  --color-info: #0031a9;
  --color-info-content: #ffffff;
  --color-success: #00663f;
  --color-success-content: #ffffff;
  --color-warning: #8a290f;
  --color-warning-content: #ffffff;
  --color-error: #a60000;
  --color-error-content: #ffffff;
  --radius-selector: 3px;
  --radius-field: 4px;
  --radius-box: 4px;
  --size-selector: 0.25rem;
  --size-field: 0.25rem;
  --border: 1px;
  --depth: 0;
  --noise: 0;
}

@font-face {
  font-family: YuYang;
  src: url("yuyang-regular.ttf") format("truetype");
  font-weight: 400;
  font-display: swap;
}
@font-face {
  font-family: YuYang;
  src: url("yuyang-medium.ttf") format("truetype");
  font-weight: 500 900;
  font-display: swap;
}
:root {
  --header-height: 60px;
  --sample: 66px;
  --muted: #595959;
  --border-color: #9f9f9f;
  --selected-bg: #ecedff;
  --success-bg: #e0f6e0;
  --warning-bg: #f8f0d0;
  font-family: YuYang, sans-serif;
  color: var(--color-base-content);
  background: var(--color-base-100);
  scrollbar-color: var(--border-color) var(--color-base-200);
  scrollbar-width: thin;
}
* { box-sizing: border-box; scrollbar-color: var(--border-color) var(--color-base-200); scrollbar-width: thin; }
*::-webkit-scrollbar { width: 8px; height: 8px; }
*::-webkit-scrollbar-track { background: var(--color-base-200); }
*::-webkit-scrollbar-thumb { background: var(--border-color); border: 2px solid var(--color-base-200); border-radius: 4px; }
body { margin: 0; font-size: 15px; line-height: 1.55; }
a { color: var(--color-primary); text-decoration: none; }
a:hover { text-decoration: underline; }
button, input, select { font: inherit; }
button, summary { cursor: pointer; }
button:disabled { cursor: wait; }
[hidden] { display: none !important; }
:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
.icon-sheet { position: absolute; width: 0; height: 0; overflow: hidden; }
.skip-link { position: absolute; top: -60px; left: 20px; z-index: 100; background: var(--color-base-100); padding: 10px; }
.skip-link:focus { top: 4px; }
.btn { font-weight: 400; box-shadow: none; }
.header { height: var(--header-height); display: flex; align-items: center; gap: 32px; padding: 0 24px; position: sticky; top: 0; z-index: 10; border-bottom: 1px solid var(--border-color); background: var(--color-base-100); }
.brand { display: flex; align-items: center; gap: 10px; min-width: 214px; color: var(--color-base-content); }
.brand:hover { text-decoration: none; }
.mark { width: 34px; height: 34px; flex-shrink: 0; }
.brand-title { font-size: 20px; display: block; line-height: 1.25; }
.brand-sub { display: block; font-size: 10px; color: var(--muted); margin-top: 3px; }
.nav { display: flex; gap: 28px; height: 100%; align-items: stretch; }
.nav a { display: flex; align-items: center; color: var(--muted); border-bottom: 3px solid transparent; }
.nav a[aria-current] { border-color: var(--color-primary); color: var(--color-primary); }
.shell { display: grid; grid-template-columns: 272px minmax(0, 1fr); }
.sidebar { position: sticky; top: var(--header-height); height: calc(100dvh - var(--header-height)); overflow-y: auto; background: var(--color-base-200); border-right: 1px solid var(--color-base-300); padding: 16px 20px; }
.sidebar-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
.sidebar-heading h2 { font-size: 16px; font-weight: 600; }
.sidebar-heading .btn { color: var(--muted); font-size: 12px; padding-inline: 0; border: 0; }
.facet { position: relative; border: 0; border-bottom: 1px solid var(--color-base-300); margin: 0; padding: 10px 0; min-width: 0; }
.facet legend { float: left; width: 100%; padding: 0; font-size: 14px; font-weight: 600; margin-bottom: 8px; }
.facet-all { position: absolute; top: 10px; right: 0; display: flex; align-items: center; gap: 5px; font-size: 12px; }
.facet-options, .check-options { clear: both; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 5px 6px; }
.facet-chip { position: relative; display: flex; align-items: center; justify-content: center; padding: 0 7px; height: 32px; text-align: center; background: var(--color-base-100); border: 1px solid transparent; border-radius: 3px; cursor: pointer; font-size: 13px; }
.facet-chip input { position: absolute; opacity: 0; width: 100%; height: 100%; inset: 0; cursor: pointer; }
.facet-chip:has(input:checked) { background: var(--selected-bg); color: var(--color-primary); border-color: var(--color-primary); }
.facet-chip:has(input:checked)::after { content: '✓'; font-size: 9px; position: absolute; right: 3px; top: 0; }
.facet-chip:has(input:focus-visible) { outline: 2px solid var(--color-primary); outline-offset: 2px; }
.facet-chip > span, .check-option > span { display: block; min-width: 0; width: 100%; max-height: 100%; line-height: 1.15; text-wrap: balance; line-break: strict; word-break: normal; overflow-wrap: normal; }
.facet-phrase { display: inline-block; max-width: 100%; vertical-align: top; }
.facet-extra { display: contents; }
.facet-options:has(.facet-extra:not([hidden])) { max-height: 300px; overflow-y: auto; overflow-x: hidden; padding: 3px; }
#style .facet-options { max-height: none; overflow: visible; }
.facet-toggle { display: flex; margin: 4px auto -4px; color: var(--muted); height: 24px; min-height: 24px; font-size: 12px; }
.facet-toggle svg { width: 12px; height: 12px; }
.facet-toggle[aria-expanded=true] svg { transform: rotate(180deg); }
.check-option { display: flex; align-items: center; gap: 6px; padding-block: 1px; height: 32px; font-size: 13px; cursor: pointer; }
.check-option input, .facet-all input { flex-shrink: 0; }
.restrictions .check-option { clear: both; }
.main { padding: 26px 40px 0; min-width: 0; container-type: inline-size; }
.heading { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 20px; }
h1 { font-size: 28px; font-weight: 600; letter-spacing: 1px; }
.count { color: var(--muted); font-size: 14px; }
.search { margin-left: auto; width: 36%; min-width: 240px; max-width: 360px; border-color: var(--border-color); background: transparent; box-shadow: none; }
.search svg { color: var(--muted); }
.search input { min-width: 0; }
.search input:focus { outline: none; }
.toolbar { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; border-block: 1px solid var(--color-base-300); padding: 12px 0; color: var(--muted); font-size: 13px; }
.language-summary { flex: 1 1 0; min-width: 0; }
#current-language { width: fit-content; max-width: 100%; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; display: block; height: auto; padding: 4px 8px; background: var(--selected-bg); color: var(--color-primary); }
.size-control { display: flex; flex-shrink: 0; align-items: center; gap: 12px; }
.size-control input { width: 110px; }
.size-control output { width: 26px; text-align: right; color: var(--color-base-content); }
#sort { flex-shrink: 0; border-left: 1px solid var(--color-base-300); border-radius: 0; width: 126px; }
.startup-status { margin: 14px 0; font-size: 13px; color: var(--muted); }
.preview-region { position: relative; min-height: 180px; }
#preview-content[aria-busy=true] { visibility: hidden; }
.preview-loading { position: absolute; inset: 0; }
.loading-message { position: sticky; top: calc(var(--header-height) + 24px); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; height: 180px; font-size: 13px; color: var(--muted); }
.loading-message .loading, .preview-status .loading { color: var(--color-primary); }
.preview-status .loading { margin-right: 10px; vertical-align: middle; }
.font-row { position: relative; padding: 26px 0 24px; border-bottom: 1px solid var(--color-base-300); }
.row-top { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; padding-right: 96px; min-height: 28px; }
.font-title { position: relative; display: flex; gap: 7px; align-items: center; min-width: 0; }
.font-name { font-size: 18px; font-weight: 600; overflow-wrap: anywhere; }
.upstream { display: inline-flex; flex-shrink: 0; }
.upstream svg { width: 15px; height: 15px; }
.upstream-menu { position: static; flex-shrink: 0; }
.upstream-toggle { align-items: center; gap: 3px; color: var(--color-primary); font-size: 12px; cursor: pointer; list-style: none; }
.upstream-toggle::-webkit-details-marker { display: none; }
.upstream-toggle svg:last-child { width: 12px; height: 12px; }
.upstream-menu[open] > summary svg:last-child { transform: rotate(180deg); }
.upstream-links { left: 0; top: calc(100% + 8px); z-index: 20; width: min(26rem, calc(100vw - 2rem)); padding: 6px; background: var(--color-base-100); border: 1px solid var(--border-color); border-radius: var(--radius-box); box-shadow: 0 4px 12px #0002; }
.upstream-links > li > a { display: flex; align-items: flex-start; gap: 8px; padding: 8px; font-size: 12px; }
.upstream-links a span { min-width: 0; overflow-wrap: anywhere; }
.upstream-links svg { flex-shrink: 0; width: 14px; height: 14px; margin-top: 2px; }
.vendor { border-left: 1px solid var(--color-base-300); padding-left: 12px; font-size: 13px; color: var(--muted); }
.face-list > summary { position: absolute; top: 28px; right: 0; display: flex; align-items: center; gap: 5px; font-size: 13px; color: var(--color-primary); list-style: none; }
.face-list > summary::-webkit-details-marker { display: none; }
.face-list > summary svg { width: 14px; height: 14px; }
.face-list[open] > summary svg { transform: rotate(180deg); }
.face-list[open] + .cover-preview { display: none; }
.face-item { margin-top: 14px; padding: 15px 16px; background: var(--color-base-200); border-radius: 4px; }
.face-caption { font-size: 14px; font-weight: 600; }
.sample { display: flex; align-items: center; height: calc(var(--sample) + 46px); overflow-x: auto; overflow-y: hidden; padding: 9px 0; }
.sample img { height: var(--sample); width: auto; max-width: none; flex-shrink: 0; display: block; }
.sample-language { font-size: 12px; color: var(--muted); margin-top: 10px; overflow-wrap: anywhere; }
.face-item .sample { height: calc(var(--sample) + 24px); }
.preview-status { padding: 24px 0; color: var(--muted); font-size: 14px; }
.cover-preview .preview-status { min-height: calc(var(--sample) + 46px); display: flex; align-items: center; }
.face-item .preview-status { min-height: calc(var(--sample) + 24px); display: flex; align-items: center; }
.row-bottom { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; margin-top: 10px; font-size: 12px; }
.copy-package { max-width: 100%; height: auto; min-height: 28px; padding: 4px 7px; border: 1px solid var(--color-base-300); color: var(--muted); }
.copy-package code { font: 12px/1.5 ui-monospace, monospace; overflow-wrap: anywhere; white-space: normal; text-align: left; }
.copy-package svg { width: 14px; height: 14px; }
.copy-package[data-copied=true] { color: var(--color-success); border-color: var(--color-success); }
.licenses { display: flex; flex-wrap: wrap; gap: 9px; align-items: center; }
.package-version { font-size: 12px; background: var(--color-base-200); color: var(--muted); border: 0; }
.cost { font-size: 12px; background: var(--success-bg); color: var(--color-success); border: 0; }
.cost-restricted { background: var(--warning-bg); color: var(--color-warning); }
.license a { text-decoration: underline; text-underline-offset: 3px; color: var(--muted); }
.redistribution { display: inline-flex; gap: 4px; align-items: center; color: var(--color-success); white-space: nowrap; }
.redistribution svg { width: 13px; height: 13px; }
.restricted { color: var(--color-warning); }
.source { margin-left: auto; display: inline-flex; gap: 4px; align-items: center; white-space: nowrap; }
.source svg { width: 14px; height: 14px; }
.package-notices, .package-info { margin-top: 12px; font-size: 12px; }
.package-notices { display: grid; gap: 14px; margin-top: 18px; }
.package-notice { --notice-color: var(--color-info); display: block; min-width: 0; padding: 6px 16px; border: 0; border-left: 3px solid var(--notice-color); border-radius: 0; background: transparent; box-shadow: none; color: var(--color-base-content); text-align: left; font-size: 13px; line-height: 1.7; }
.package-notice[data-notice-level=warning] { --notice-color: var(--color-warning); }
.package-notice[data-notice-level=caution] { --notice-color: var(--color-error); }
.package-notice[data-notice-level=important] { --notice-color: var(--color-secondary); }
.package-notice[data-notice-level=tip] { --notice-color: var(--color-success); }
.notice-heading { display: flex; align-items: center; gap: 7px; margin-bottom: 8px; color: var(--notice-color); font-size: 13px; font-weight: 500; }
.notice-heading svg { width: 16px; height: 16px; }
.notice-source { margin-top: 8px; font-size: 12px; }
.package-info { color: var(--muted); }
.info-toggle { display: flex; align-items: center; gap: 6px; width: fit-content; max-width: 100%; margin-inline: auto; padding: 3px 0; color: var(--muted); font-size: 12px; list-style: none; }
.info-toggle::-webkit-details-marker { display: none; }
.info-toggle:hover { color: var(--color-primary); }
.info-toggle:hover span { text-decoration: underline; text-underline-offset: 3px; }
.info-toggle .info-hide, .package-info[open] > .info-toggle .info-show { display: none; }
.package-info[open] > .info-toggle .info-hide { display: inline; }
.info-toggle svg { width: 14px; height: 14px; transition: transform 150ms ease; }
.package-info[open] > .info-toggle svg { transform: rotate(180deg); }
.package-metadata { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 12px 16px; margin-top: 16px; font-size: 13px; line-height: 1.8; }
.package-metadata dt { color: var(--muted); }
.package-metadata dd { min-width: 0; color: var(--color-base-content); overflow-wrap: anywhere; }
.notice-text { white-space: pre-wrap; overflow-wrap: anywhere; }
.license-text { margin-top: 16px; padding: 20px; border: 1px solid var(--color-base-300); border-radius: var(--radius-box); background: var(--color-base-200); }
.empty { padding: 70px 10px; text-align: center; color: var(--muted); }
.empty h2 { font-size: 20px; color: var(--color-base-content); margin-bottom: 12px; }
.site-footer { display: flex; align-items: center; justify-content: center; gap: 10px; padding: 40px 2px; color: var(--muted); font-size: 12px; white-space: nowrap; }
.site-footer > * { flex-shrink: 0; }
.site-footer a { color: inherit; }
.footer-separator { height: 12px; border-left: 1px solid var(--color-base-300); }
.site-license { display: inline-flex; align-items: center; gap: 6px; }
.site-license img { width: 80px; height: 15px; }
.mobile-filter { display: none; }
@container (max-width: 640px) {
  .site-footer { flex-direction: column; gap: 12px; text-align: center; white-space: normal; }
  .footer-separator { display: none; }
}
@media (max-width: 1200px) {
  .shell { grid-template-columns: 236px minmax(0, 1fr); }
  .sidebar { padding: 10px 14px; }
  .main { padding: 22px 30px 0; }
  .row-bottom .copy-package { margin-right: 100%; }
  .facet-chip { font-size: 12px; padding-inline: 4px; }
}
@media (max-width: 760px) {
  :root { --header-height: 56px; }
  .header { padding: 0 16px; gap: 12px; }
  .brand { min-width: 0; }
  .brand-title { font-size: 18px; }
  .nav { display: none; }
  .mobile-filter { display: inline-flex; margin-left: auto; }
  .shell { display: block; }
  .sidebar { display: none; position: static; height: auto; max-height: 65dvh; border-bottom: 1px solid var(--border-color); }
  .sidebar[data-open=true] { display: block; }
  .main { padding: 20px 16px 0; }
  .heading { gap: 10px; margin-bottom: 14px; }
  h1 { font-size: 25px; }
  .search { width: 100%; max-width: none; margin-top: 4px; }
  .toolbar { gap: 10px; font-size: 12px; }
  .language-summary { flex-basis: 100%; }
  .size-control { gap: 8px; }
  .size-control input { width: 75px; }
  #sort { width: 118px; margin-left: auto; }
  .row-top { gap: 8px; padding-right: 80px; }
  .font-name { font-size: 17px; }
  .vendor { font-size: 12px; }
  .face-list > summary { font-size: 12px; }
  .font-row { padding: 22px 0; }
  .face-list > summary { top: 26px; }
  .source { margin-left: 0; }
}
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; } .loading { animation: none !important; } }
