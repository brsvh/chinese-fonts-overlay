(use-modules (chinese-fonts-overlay pages server http)
             (chinese-fonts-overlay pages util)
             (ice-9 binary-ports)
             (ice-9 match)
             (rnrs bytevectors)
             (srfi srfi-11)
             (srfi srfi-64)
             (web request)
             (web response)
             (web uri))

(test-begin "server")
(define runner (test-runner-current))
(define temporary (temporary-directory (or (getenv "TMPDIR") "/tmp")))

(dynamic-wind
  (lambda () #t)
  (lambda ()
    (let ((root (string-append temporary "/public"))
          (image-bytes #vu8(0 128 255 13 10)))
      (define* (request-path path #:optional (method 'GET))
        (file-response
         root
         (build-request
          (string->uri (string-append "http://localhost" path))
          #:method method)))
      (mkdir-p root)
      (write-text (string-append root "/index.html") "中文预览")
      (write-text (string-append root "/a+b.json") "{}")
      (call-with-output-file (string-append root "/sample.webp")
        (lambda (port) (put-bytevector port image-bytes))
        #:binary #t)
      (write-text (string-append temporary "/private") "private")
      (symlink (string-append temporary "/private")
               (string-append root "/outside"))
      (for-each
       (match-lambda
         ((path media-type expected)
          (for-each
           (lambda (method)
             (let-values (((response body) (request-path path method)))
               (test-assert
                 (format #f "~a ~a preserves its HTTP representation"
                         method path)
                 (and (= 200 (response-code response))
                      (eq? media-type (car (response-content-type response)))
                      (= (bytevector-length expected)
                         (response-content-length response))
                      (if (eq? method 'HEAD)
                          (not body)
                          (equal? body expected))))))
           '(GET HEAD))))
       `(("/" text/html ,(string->utf8 "中文预览"))
         ("/sample.webp" image/webp ,image-bytes)))
      (for-each
       (lambda (entry)
         (let-values (((response _body) (request-path (car entry))))
           (test-equal (car entry) (cdr entry) (response-code response))))
       '(("/missing" . 404)
         ("/outside" . 404)
         ("/%2e%2e/private" . 404)
         ("/manual%2Findex.html" . 400)
         ("/a+b.json" . 200)
         ("/a%2Bb.json" . 200)
         ("/a%252Bb.json" . 404)
         ("/%00" . 400)
         ("/%xx" . 400)))
      (let-values (((response _body) (request-path "/" 'OPTIONS)))
        (test-equal "Only GET and HEAD" 405 (response-code response)))))
  (lambda () (delete-tree temporary)))

(test-end "server")
(exit (and (zero? (test-runner-fail-count runner))
           (zero? (test-runner-xpass-count runner))))
