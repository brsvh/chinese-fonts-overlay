{
  fetchurl,
  lib,
  stdenvNoCC,
  unzip,
  ...
}:
let
  inherit (lib)
    licenses
    maintainers
    platforms
    ;

  pname = "chill-round-f";
  version = "3.200";

  src = fetchurl {
    hash = "sha256-egYeOcyPN3zhIvCuaNH+PvQ9eEMTiDYsYeqNaVci0mc=";
    url = "https://github.com/Warren2060/ChillRound/releases/download/v${version}/ChillRoundF_v${version}.zip";
  };

  meta = {
    description = "Chill Round F full-rounded Chinese fonts";

    homepage = [
      "https://github.com/Warren2060/ChillRound"
    ];

    license = licenses.ofl;

    longDescription = ''
      Provides Chill Round F from ChillType, a full-rounded Chinese typeface
      derived from Kosugi Maru, jf open huninn, and Maoken Tangyuan.
      Includes Regular and Bold OpenType weights.
    '';

    maintainers = with maintainers; [ brsvh ];
    platforms = platforms.all;
    redistributable = true;
  };
in
stdenvNoCC.mkDerivation {
  inherit
    meta
    pname
    src
    version
    ;

  installPhase = ''
    runHook preInstall

    fontDir=$out/share/fonts/opentype/chilltype
    docDir=$out/share/doc/${pname}
    find . -type f -name '*.otf' ! -path '*/__MACOSX/*' \
      -exec install -Dm444 -t "$fontDir" {} +
    find . -type f -name 'LICENSE.txt' ! -path '*/__MACOSX/*' \
      -exec install -Dm444 {} "$docDir/LICENSE.txt" \;

    runHook postInstall
  '';

  nativeBuildInputs = [
    unzip
  ];

