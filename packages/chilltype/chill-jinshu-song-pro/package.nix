{
  fetchurl,
  lib,
  stdenvNoCC,
  unzip,
  ...
}:
let
  inherit (lib)
    licenses
    maintainers
    platforms
    ;

  pname = "chill-jinshu-song-pro";
  version = "2.0";

  src = fetchurl {
    hash = "sha256-paBmwf30eydfF7F0c/Y4AFZPVdpRAgb3df39lN25/l8=";
    url = "https://github.com/Warren2060/ChillJinshuSong/releases/download/GBv${version}/ChillJinshuSong_v${version}.zip";
  };

  licenseSrc = fetchurl {
    hash = "sha256-An9vaKo8ZRp3HTNo59FiCsrq39XQDSPaRDMlZbwVGGk=";
    url = "https://raw.githubusercontent.com/Warren2060/ChillJinshuSong/58b387e4a2c49c38c9113bbccdc64d2486e45829/LICENSE";
  };

  meta = {
    description = "Chill Jinshu Song Pro extended Chinese serif fonts";

    homepage = [
      "https://github.com/Warren2060/ChillJinshuSong"
    ];

    license = licenses.ofl;

    longDescription = ''
      Provides Chill Jinshu Song Pro from ChillType, an extended-character-set
      rounded Chinese serif family derived from Source Han Serif. Includes
      Regular, Soft, and Italic OpenType styles.
    '';

    maintainers = with maintainers; [ brsvh ];
    platforms = platforms.all;
    redistributable = true;
  };
in
stdenvNoCC.mkDerivation {
  inherit
    meta
    pname
    src
    version
    ;

  installPhase = ''
    runHook preInstall

    fontDir=$out/share/fonts/opentype/chilltype
    docDir=$out/share/doc/${pname}
    find . -type f -name 'ChillJinshuSongPro_*.otf' ! -path '*/__MACOSX/*' \
      -exec install -Dm444 -t "$fontDir" {} +
    install -Dm444 ${licenseSrc} "$docDir/LICENSE"

    runHook postInstall
  '';

  nativeBuildInputs = [
    unzip
  ];

  passthru = {
