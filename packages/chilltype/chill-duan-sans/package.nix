{
  fetchurl,
  lib,
  stdenvNoCC,
  unzip,
  ...
}:
let
  inherit (lib)
    licenses
    maintainers
    platforms
    ;

  pname = "chill-duan-sans";
  version = "1.30";

  src = fetchurl {
    hash = "sha256-aEcQY+cfH/pNZ2v8KDri5g4yiqKcK8tS99p49S8q3d0=";
    url = "https://github.com/Warren2060/ChillDuanSans/releases/download/v${version}/ChillDuanSans.v${version}.zip";
  };

  meta = {
    description = "Chill Duan Sans static wide and condensed Chinese sans-serif fonts";

    homepage = [
      "https://github.com/Warren2060/ChillDuanSans"
    ];

    license = licenses.ofl;

    longDescription = ''
      Provides Chill Duan Sans from ChillType, re-interpolated static
      OpenType fonts derived from Source Han Sans paired with Figtree Latin
      glyphs. Includes six Basic weights and twelve Expanded, Wide, Compact,
      and Condensed styles.
    '';

    maintainers = with maintainers; [ brsvh ];
    platforms = platforms.all;
    redistributable = true;
  };
in
stdenvNoCC.mkDerivation {
  inherit
    meta
    pname
    src
    version
    ;

  installPhase = ''
    runHook preInstall

    fontDir=$out/share/fonts/opentype/chilltype
    docDir=$out/share/doc/${pname}
    find . -type f -name '*.otf' ! -path '*/__MACOSX/*' \
      -exec install -Dm444 -t "$fontDir" {} +
    find . -type f -name 'License.txt' ! -path '*/__MACOSX/*' \
      -exec install -Dm444 {} "$docDir/LICENSE.txt" \;

    runHook postInstall
  '';

  nativeBuildInputs = [
    unzip
  ];

  passthru = {
