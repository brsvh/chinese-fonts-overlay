{
  fetchurl,
  lib,
  stdenvNoCC,
  unzip,
  ...
}:
let
  inherit (lib)
    licenses
    maintainers
    platforms
    ;

  pname = "chill-din-gothic-vf";
  version = "1.300";

  src = fetchurl {
    hash = "sha256-K+ok9utLs8zOUW0XBPIiWlBLtf/61s7igmnMmWS6C4Q=";
    url = "https://github.com/Warren2060/ChillDIN-ChillDINGothic/releases/download/ChillDINGothic_v${version}/ChillDINGothic.v${version}.zip";
  };

  licenseSrc = fetchurl {
    hash = "sha256-HDZSnA0M7eCRgM0a8+CgC8kTstwXKfcmhLjFq6dqPwc=";
    url = "https://raw.githubusercontent.com/Warren2060/ChillDIN-ChillDINGothic/d5251e66ded29639397025784c72dc2ac12bc817/license";
  };

  meta = {
    description = "Chill DIN Gothic variable Chinese sans-serif font paired with ChillDIN";

    homepage = [
      "https://github.com/Warren2060/ChillDIN-ChillDINGothic"
    ];

    license = licenses.ofl;

    longDescription = ''
      Provides Chill DIN Gothic VF from ChillType, a variable TrueType font
      combining ChillDIN Latin glyphs with Chinese glyphs adapted from
      Chill Duan Sans and Source Han Sans.
    '';

    maintainers = with maintainers; [ brsvh ];
    platforms = platforms.all;
    redistributable = true;
  };
in
stdenvNoCC.mkDerivation {
  inherit
    meta
    pname
    src
    version
    ;

  installPhase = ''
    runHook preInstall

    fontDir=$out/share/fonts/truetype/chilltype
    docDir=$out/share/doc/${pname}
    find . -type f -name 'ChillDINGothicVF.ttf' ! -path '*/__MACOSX/*' \
      -exec install -Dm444 -t "$fontDir" {} +
    install -Dm444 ${licenseSrc} "$docDir/LICENSE"

    runHook postInstall
  '';

  nativeBuildInputs = [
    unzip
  ];

