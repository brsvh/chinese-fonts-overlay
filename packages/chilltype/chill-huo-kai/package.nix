{
  fetchurl,
  lib,
  stdenvNoCC,
  unzip,
  ...
}:
let
  inherit (lib)
    licenses
    maintainers
    platforms
    ;

  pname = "chill-huo-kai";
  version = "1.000";

  src = fetchurl {
    hash = "sha256-8Hc/zNzyt66dAsGk7oHTWw95WidrUTxH5mSKHSNCi00=";
    url = "https://github.com/Warren2060/ChillMovableType/releases/download/HuoKaiv${version}/ChillHuoKai.zip";
  };

  licenseSrc = fetchurl {
    hash = "sha256-x8ZpEx6CC0vW2ZFaS1bJVna8/43d7zcW4ijvBiVObT8=";
    url = "https://raw.githubusercontent.com/Warren2060/ChillMovableType/d0a36cfb5912e891c0492d3ff5c04584e05b9409/LICENSE";
  };

  meta = {
    description = "Chill Huo Kai movable-type letterpress Chinese regular-script fonts";

    homepage = [
      "https://github.com/Warren2060/ChillMovableType"
    ];

    license = licenses.ofl;

    longDescription = ''
      Provides Chill Huo Kai from the ChillType ChillMovableType project, a
      letterpress-textured Chinese regular-script family derived from CNS
      11643 Kai, Chill Kai, and Gentium. Includes three OpenType styles:
      Regular, ConRegular, and ConBold.
    '';

    maintainers = with maintainers; [ brsvh ];
    platforms = platforms.all;
    redistributable = true;
  };
in
stdenvNoCC.mkDerivation {
  inherit
    meta
    pname
    src
    version
    ;

  installPhase = ''
    runHook preInstall

    fontDir=$out/share/fonts/opentype/chilltype
    docDir=$out/share/doc/${pname}
    find . -type f -name '*.otf' ! -path '*/__MACOSX/*' \
      -exec install -Dm444 -t "$fontDir" {} +
    install -Dm444 ${licenseSrc} "$docDir/LICENSE"

    runHook postInstall
  '';

  nativeBuildInputs = [
    unzip
  ];

