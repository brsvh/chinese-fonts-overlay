/.bake.toml
/.clang-format
/.editorconfig
/.perltidyrc
/biome.json
/prek.toml
/treefmt.toml

# direnv
/.envrc
/.direnv

# emacs
/.dir-locals.el

# nix
/repl-result-out
/result
/result-*

# local CI results
/.ci-work

# previews
/font-preview-images

# Website and manual outputs
/pages/build/
/pages/.cache/

# .gitignore ends here
