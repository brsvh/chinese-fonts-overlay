# .gitignore --- Git untracked files -*- mode: gitignore; -*-

# devshells
/.bake.toml
/.clang-format
/.editorconfig
/prek.toml
/treefmt.toml

# direnv
/.envrc
/.direnv

# emacs
/.dir-locals.el

# nix
/repl-result-out
/result
/result-*

# local CI results
/.ci-work

# previews
/font-preview-images

# site
/site/dist/
/site/.cache/
/site/build/
/tools/update-font-languages/build/
/site/public/
/site/cache/
/site/autom4te.cache/
/site/aclocal.m4
/site/configure
/site/configure~
/site/Makefile
/site/Makefile.in
/site/build-aux/compile
/site/build-aux/depcomp
/site/build-aux/install-sh
/site/build-aux/missing
/site/build-aux/test-driver
/site/compiled-web/
/site/chinese-fonts-overlay-site
/site/font-info
/site/render-font-samples
/site/image-fixtures
/site/config.log
/site/config.cache
/site/config.status
/site/src/.deps/
/site/src/.dirstamp
/site/src/*.o
/site/*.log
/site/tests/*.log
/site/tests/*.trs
/site/tests/.deps/
/site/tests/.dirstamp
/site/tests/*.o
/site/*.tar.xz

# .gitignore ends here
